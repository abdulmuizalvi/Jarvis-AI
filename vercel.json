{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter desktop build:web",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "outputDirectory": "apps/desktop/dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
